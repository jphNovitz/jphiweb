{% extends 'base.html.twig' %}

{% block title %}Contactez-moi pour votre projet | Jphiweb{% endblock %}
{% block og_title %}Contactez-moi pour votre projet | Jphiweb{% endblock %}
{# {% block og_image %}{{ asset("images/blog/"~image_url) }}{% endblock %} #}
{% block og_description %}Je suis développeur PHP (Symfony, Laravel, WordPress, PrestaShop). Contactez-moi pour vous aider sur votre projet.{% endblock %}
{% block metas %}
    <meta name="description"
          content="Je suis développeur PHP (Symfony, Laravel, WordPress, PrestaShop). Contactez-moi pour vous aider sur votre projet."/>
{% endblock %}

{% block body %}

    <section class="">
        <div class="py-8 lg:py-16 px-4 mx-auto max-w-screen-md">
            <twig:Title:H2> Me contacter  </twig:Title:H2>
            <p class="mb-8 lg:mb-16 font-light text-center text-content-primary-light/60 dark:text-content-primary-dark/50 sm:text-xl">
                N'hésitez à envoyer un message pour décrire votre projet, votre objectif ou juste poser
                une question.
            </p>
            <p class="mb-8 lg:mb-16 font-light text-center text-content-primary-light/60 dark:text-content-primary-dark/50 sm:text-xl">
                <a href="mailto:bonjour@jphiweb.be" class=" hover:underline hover:font-semibold">
                    bonjour@jphiweb.be
                </a>
            </p>
            {{ form_start(form, {'attr': {'class':'space-y-8'}}) }}
            <div>
                <twig:Form:Label :field="form.name"/>
                <twig:Form:WidgetText :field="form.name"/>
            </div>
            <div>
                <twig:Form:Label :field="form.email"/>
                <twig:Form:WidgetText :field="form.email"/>
            </div>

            <div class="sm:col-span-2">
                <twig:Form:Label :field="form.text"/>
                {{ form_widget(form.text, {'attr': {
                    'rows': '6',
                    'class': 'block p-2.5 w-full shadow-sm bg-base-light/30 border border-base-light/30 text-content-primary-light text-sm rounded-lg focus:ring-content-secondary/50 focus:border-content-secondary/50 block w-full p-2.5 dark:bg-base-light/10 dark:border-content-secondary/50 dark:placeholder-content-primary-dark/40 dark:text-content-primary-dark/90 dark:focus:ring-content-secondary/50 dark:focus:border-content-secondary/50 dark:shadow-sm-light'}}) }}
            </div>
            <twig:Form:Widget-Submit :field="form.save"/>
            {{ form_end(form) }}
        </div>
    </section>

{% endblock %}
