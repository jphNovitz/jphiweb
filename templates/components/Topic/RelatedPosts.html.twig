{% if parentTopic is not null or childrenTopics is not empty or relatedPosts is not empty %}
    <aside{{ attributes.defaults({ class: "w-full p-4" }) }} aria-labelledby="related-content-title">
        <nav aria-label="Contenu associé">
            <h2 id="related-content-title" class="text-xl font-semibold mb-3">
                À lire aussi
            </h2>

            <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
                {% if parentTopic is not null %}
                    <div class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
                        <figure class="relative aspect-video overflow-hidden">
                            {% if parentTopic.image %}
                                {% set size = image_size('images/topic/' ~ parentTopic.image) %}
                                <img src="{{ asset('images/topic/' ~ parentTopic.image) }}" alt="{{ parentTopic.imageAlt ?: parentTopic.title }}" class="w-full h-full object-cover" loading="lazy" decoding="async"{% if size %} width="{{ size.width }}" height="{{ size.height }}"{% endif %}/>
                            {% else %}
                                <div class="w-full h-full bg-base-200 flex items-center justify-center text-base-content/60">Aperçu</div>
                            {% endif %}
                        </figure>
                        <div class="card-body p-4">
                            <h3 class="card-title text-base md:text-lg">
                                <a href="{{ path('app_topic_show', {'slug': parentTopic.slug}) }}">
                                    {{ parentTopic.title }}
                                </a>
                            </h3>
                            {% if parentTopic.summary %}
                                <p class="text-sm opacity-80 leading-tight">
                                    <a href="{{ path('app_topic_show', {'slug': parentTopic.slug}) }}" class="no-underline">
                                        {{ parentTopic.summary|striptags }}
                                    </a>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% for childTopic in childrenTopics %}
                    <div class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
                        <figure class="relative aspect-video overflow-hidden">
                            {% if childTopic.image %}
                                {% set size = image_size('images/topic/' ~ childTopic.image) %}
                                <img src="{{ asset('images/topic/' ~ childTopic.image) }}" alt="{{ childTopic.imageAlt ?: childTopic.title }}" class="w-full h-full object-cover" loading="lazy" decoding="async"{% if size %} width="{{ size.width }}" height="{{ size.height }}"{% endif %}/>
                            {% else %}
                                <div class="w-full h-full bg-base-200 flex items-center justify-center text-base-content/60">Aperçu</div>
                            {% endif %}
                        </figure>
                        <div class="card-body p-4">
                            <h3 class="card-title text-base md:text-lg">
                                <a href="{{ path('app_topic_show', {'slug': childTopic.slug}) }}">
                                    {{ childTopic.title }}
                                </a>
                            </h3>
                            {% if childTopic.summary %}
                                <p class="text-sm opacity-80 leading-tight">
                                    <a href="{{ path('app_topic_show', {'slug': childTopic.slug}) }}" class="no-underline">
                                        {{ childTopic.summary|striptags }}
                                    </a>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}

                {% for post in relatedPosts %}
                    <div class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
                        <figure class="relative aspect-video overflow-hidden">
                            {% if post.image %}
                                {% set size = image_size('images/blog/' ~ post.image) %}
                                <img src="{{ asset('images/blog/' ~ post.image) }}" alt="{{ post.imageAlt ?: post.title }}" class="w-full h-full object-cover" loading="lazy" decoding="async"{% if size %} width="{{ size.width }}" height="{{ size.height }}"{% endif %}/>
                            {% else %}
                                <div class="w-full h-full bg-base-200 flex items-center justify-center text-base-content/60">Aperçu</div>
                            {% endif %}
                        </figure>
                        <div class="card-body p-4">
                            <h3 class="card-title text-base md:text-lg">
                                <a href="{{ path('app_blog_show', {'topicSlug': post.topic.slug, 'slug': post.slug}) }}">
                                    {{ post.title }}
                                </a>
                            </h3>
                            {% if post.summary %}
                                <p class="text-sm opacity-80 leading-tight">
                                    <a href="{{ path('app_blog_show', {'topicSlug': post.topic.slug, 'slug': post.slug}) }}" class="no-underline">
                                        {{ post.summary|striptags }}
                                    </a>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </nav>
    </aside>
{% endif %}
