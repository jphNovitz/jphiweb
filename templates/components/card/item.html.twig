{# Anonymous Twig component: x-card.item
   Expects a `work` variable (entity or array) with properties used below:
   - work.image
   - work.name
   - work.descriptionShort
   - work.price
   - work.type.value
   - work.slug
 #}
<article class="card bg-base-100 card-lg shadow-sm transition-all">
    <figure class="aspect-square overflow-hidden p-10">
        {% if work.image %}
            <img src="/images/work/{{ asset(work.image) }}" alt="{{ work.name }}"
                 class="w-full h-full object-cover"/>
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-base-content/20" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
        {% endif %}
    </figure>

    <div class="card-body">

        <h2 class="card-title">{{ work.name }}</h2>

        {% if work.descriptionShort %}
            <p class="text-sm text-base-content/60 leading-relaxed">
                {{ work.descriptionShort }}
            </p>
        {% endif %}

        {% if work.price %}
            <div class="mt-auto text-center">
                {% if work.showStartingFrom %}
                    <p class="text-sm text-base-content/60 leading-tight mb-0">{{ enum('App\\Enum\\PriceMention').StartingFrom.label }}</p>
                {% endif %}
                <p class="text-xl font-medium leading-tight">{{ work.price }} € HTVA</p>
            </div>
        {% endif %}
    </div>
    <div class="card-actions justify-center p-8">
        <a href="{{ path('app_work_show', {type: work.type.value, slug: work.slug}) }}" class="btn btn-primary w-fit rounded-lg">
            {{ 'more'|trans }}
        </a>
    </div>
</article>

