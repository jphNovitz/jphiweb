<article class="w-full mx-auto mt-8 p-6 bg-white/10 rounded-lg shadow-lg">
    <div class="max-w-2xl mx-auto">

        <header class="mb-12">
            {% if home %}
                <h2 class="text-3xl font-bold text-left">
                    {{ title }}
                </h2>
            {% else %}
                <h1 class="text-3xl font-bold text-left">
                    {{ title }}
                </h1>
            {% endif %}

            {% if summary is defined and summary is not empty %}
                <p class="mt-4">{{ summary }}</p>
            {% endif %}
        </header>

        <div class="flex flex-col items-start leading-8 text-lg mx-auto my-8">
            {% if image_url is not empty %}
                {% set size = image_size('images/' ~ image_url) %}
                <figure class="w-full text-center">
                    <img
                            class="w-full h-auto mx-auto my-8 rounded-lg shadow-md"
                            src="{{ asset('images/' ~ image_url) }}"
                            {% if size %}width="{{ size.width }}" height="{{ size.height }}"{% endif %}
                            fetchpriority="high"
                            {% if image_alt is not empty %}
                                alt="{{ image_alt }}"
                            {% else %}
                                alt="{{ title }}"
                            {% endif %}
                    />
                </figure>
            {% endif %}

            {{ content | raw }}
        </div>
    </div>
</article>
