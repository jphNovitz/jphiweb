{% extends 'base.html.twig' %}

{% block title %}{{ type.label() }} | Jphiweb{% endblock %}

{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}, {label: 'Services', url: path('app_work_index')}],
        current: type.value
    }) }}
{% endblock %}

{% block body %}

    {# ── Header de section ─────────────────────────────────────────────────────── #}
    <section class="bg-base-100 border-b border-base-200">
        <div class="max-w-5xl mx-auto px-6 py-12">

            <a href="{{ path('app_work_index') }}"
               class="text-sm text-base-content/40 inline-flex items-center gap-1 mb-6 hover:text-base-content/60">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
                Tous les services
            </a>

            <h1 class="text-3xl lg:text-4xl font-bold text-base-content">
                {{ type.label() }}
            </h1>

        </div>
    </section>

    {# ── Liste des works ───────────────────────────────────────────────────────── #}
    <section class="bg-base-200">
        <div class="max-w-5xl mx-auto px-6 py-12">

            {% if works is empty %}
                <p class="text-base-content/50 text-sm">Aucun service disponible pour le moment.</p>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

                    {% for work in works %}

                        <twig:card:item :work="work" :type="type.value"/>

                    {% endfor %}

                </div>
            {% endif %}

        </div>
    </section>

{% endblock %}