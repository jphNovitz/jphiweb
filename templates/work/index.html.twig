{% extends 'base.html.twig' %}

{% block title %}Création et refonte de sites web Brabant Wallon | Jphiweb{% endblock %}
{% block metas %}
    <meta name="description"
          content="Indépendant ou PME en Brabant Wallon ? Je vous accompagne dans la création, la refonte ou l'évolution de votre site web. Parlons de votre projet."/>
{% endblock %}
{% block og_title %}Création et refonte de sites web Brabant Wallon | Jphiweb{% endblock %}
{% block og_description %}Indépendant ou PME en Brabant Wallon ? Je vous accompagne dans la création, la refonte ou l'évolution de votre site web. Parlons de votre projet.{% endblock %}

{% block og_type %}website{% endblock %}
{% block og_site_name %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}
{% block twitter_title %}Création et refonte de sites web Brabant Wallon | Jphiweb{% endblock %}
{% block twitter_description %}Indépendant ou PME en Brabant Wallon ? Je vous accompagne dans la création, la refonte ou l'évolution de votre site web. Parlons de votre projet.{% endblock %}
{# {% block twitter_image %}https://jphiweb.be/images/jphiweb_facebook_image.webp{% endblock %} #}
{% block twitter_image_alt %}Création et refonte de sites web Brabant Wallon | Jphiweb{% endblock %}


{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}],
        current: 'Services'
    }) }}
{% endblock %}

{% block body %}

    {# ── Hero ─────────────────────────────────────────────────────────────────── #}
    <section class="bg-base-100 border-b border-base-200">
        <div class="max-w-3xl mx-auto px-6 py-16 text-center">

            <h1 class="text-4xl lg:text-5xl font-bold text-base-content leading-tight mb-6">
                Création et refonte de sites web en Brabant Wallon
            </h1>

            <p class="text-base text-left text-base-content/60 leading-relaxed max-w-xl mx-auto mb-10">
                Basé à Court-Saint-Etienne, j'accompagne les indépendants et PME du Brabant Wallon dans leurs projets
                web, de la première présence en ligne jusqu'au développement sur mesure.
                Que vous partiez de zéro ou souhaitiez faire évoluer un site existant, je vous propose une approche
                adaptée à votre situation.
            </p>

            <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                Discutons de votre projet
            </a>

        </div>
    </section>

    <section class="border border-primary p-8 my-4 flex flex-col">
        <h2 class="card-title text-base font-semibold"> Pas encore prêt pour un site ?</h2>
        <p>
            Créez votre carte de visite numérique : coordonnées, QR code, lien à partager. Sans compte ni abonnement.
            <br /><a href="https://cartes.jphiweb.be"  class="text-sm link link-hover font-medium text-primary inline-flex items-center gap-1 mt-auto">
                Créer ma carte gratuite
            </a>
        </p>
    </section>

    {# ── Cartes formules ───────────────────────────────────────────────────────── #}
    <section class="bg-base-200">
        <div class="max-w-5xl mx-auto px-6 py-14">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                {# Carte 1 — Partir de zéro #}
                <div class="card bg-base-100 border border-base-200 shadow-none">
                    <div class="card-body gap-4">

                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                            </svg>
                        </div>

                        <h2 class="card-title text-base font-semibold"> Vous partez de zéro ? </h2>

                        <p class="text-sm text-base-content/60 leading-relaxed">
                            Vous lancez votre activité dans le Brabant Wallon et n'avez encore rien en ligne.
                            Je vous propose la création de votre site internet, rapide à mettre en place et taillé pour
                            votre métier. </p>

                        <a href="{{ path('app_work_type', {type: 'creation'}) }}"
                           class="text-sm link link-hover font-medium text-primary inline-flex items-center gap-1 mt-auto">
                            Voir les formules
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </a>

                    </div>
                </div>

                {# Carte 2 — Faire évoluer #}
                <div class="card bg-base-100 border border-base-200 shadow-none">
                    <div class="card-body gap-4">

                        <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-success" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                            </svg>
                        </div>

                        <h2 class="card-title text-base font-semibold">Faites évoluer votre site</h2>

                        <p class="text-sm text-base-content/60 leading-relaxed">
                            Votre site date un peu ? Il n'est peut-être pas nécessaire de tout recommencer : une refonte
                            pour le moderniser ou l'adapter au mobile peut suffire pour lui redonner tout son potentiel.
                        </p>

                        <a href="{{ path('app_work_type', {type: 'evolution'}) }}"
                           class="text-sm link link-hover font-medium text-success inline-flex items-center gap-1 mt-auto">
                            Voir les services
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </a>

                    </div>
                </div>

                {# Carte 3 — Projet défini #}
                <div class="card bg-base-100 border border-base-200 shadow-none">
                    <div class="card-body gap-4">

                        <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-warning" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>

                        <h2 class="card-title text-base font-semibold">Votre projet est clair ?</h2>

                        <p class="text-sm text-base-content/60 leading-relaxed">
                            Boutique en ligne, développement web sur mesure : je vous accompagne de A à Z sur vos
                            projets ambitieux.
                        </p>

                        <a href="{{ path('app_contact') }}"
                           class="text-sm link link-hover font-medium text-warning inline-flex items-center gap-1 mt-auto">
                            Contactez-moi
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </a>
                        {#                            <a href="{{ path('app_work_type', {type: 'projet'}) }}" class="text-sm font-medium text-warning inline-flex items-center gap-1 mt-auto"> #}
                        {#                                En savoir plus #}
                        {#                                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"> #}
                        {#                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/> #}
                        {#                                </svg> #}
                        {#                            </a> #}

                    </div>
                </div>

            </div>
        </div>
    </section>

    {# ── CTA final ─────────────────────────────────────────────────────────────── #}
    <section class="bg-base-100 border-t border-base-200">
        <div class="max-w-2xl mx-auto px-6 py-16 text-center">

            <p class="text-base text-base-content/60 leading-relaxed mb-4">
                Une idée, un projet précis ou simplement l'envie de vous lancer ? Commencez petit et évoluez ensuite :
                l'important, c'est de démarrer.
            </p>

            <a href="mailto:bonjour@jphiweb.be" class="text-sm text-primary block mb-8">
                bonjour@jphiweb.be
            </a>

            <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                Parlons de votre projet
            </a>

        </div>
    </section>

{% endblock %}
