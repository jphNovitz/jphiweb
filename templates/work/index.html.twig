{% extends 'base.html.twig' %}

{% block title %}Création et refonte de sites web Brabant Wallon | Jphiweb{% endblock %}
{% block metas %}
    <meta name="description"
          content="Indépendant ou PME en Brabant Wallon ? Je vous accompagne dans la création, la refonte ou l'évolution de votre site web. Parlons de votre projet."/>
{% endblock %}
{% block og_title %}Création et refonte de sites web Brabant Wallon | Jphiweb{% endblock %}
{% block og_description %}Indépendant ou PME en Brabant Wallon ? Je vous accompagne dans la création, la refonte ou l'évolution de votre site web. Parlons de votre projet.{% endblock %}

{% block og_type %}website{% endblock %}
{% block og_site_name %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}


{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}],
        current: 'Services'
    }) }}
{% endblock %}

{% block body %}

    {# ── Hero ─────────────────────────────────────────────────────────────────── #}
    <section class="bg-base-100 border-b border-base-200">
        <div class="max-w-3xl mx-auto px-6 py-16 text-center">

            <h1 class="text-4xl lg:text-5xl font-bold text-base-content leading-tight mb-6">
                Création et refonte de sites web en Brabant Wallon
            </h1>

            <p class="text-base text-left text-base-content/60 leading-relaxed max-w-xl mx-auto mb-10">
                Basé à Court-Saint-Etienne, j'accompagne les indépendants et PME du Brabant Wallon dans leurs projets
                web, de la première présence en ligne jusqu'au développement sur mesure.
                Que vous partiez de zéro ou souhaitiez faire évoluer un site existant, je vous propose une approche
                adaptée à votre situation.
            </p>

            <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                Discutons de votre projet
            </a>

        </div>
    </section>

    <section class="border border-primary p-8 my-4 flex flex-col">
        <h2 class="card-title text-base font-semibold"> Pas encore prêt pour un site ?</h2>
        <p>
            Créez votre carte de visite numérique : coordonnées, QR code, lien à partager. Sans compte ni abonnement.
            <br /><a href="https://cartes.jphiweb.be"  class="text-sm link link-hover font-medium text-primary inline-flex items-center gap-1 mt-auto">
                Créer ma carte gratuite
            </a>
        </p>
    </section>

    {# ── Fiches services ──────────────────────────────────────────────────────── #}
    <section class="bg-base-200">
        <div class="max-w-5xl mx-auto px-6 py-14">
            {% if works is empty %}
                <p class="text-base-content/50 text-sm">Aucun service disponible pour le moment.</p>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for work in works %}
                        <twig:card:item :work="work"/>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {# ── CTA final ─────────────────────────────────────────────────────────────── #}
    <section class="bg-base-100 border-t border-base-200">
        <div class="max-w-2xl mx-auto px-6 py-16 text-center">

            <p class="text-base text-base-content/60 leading-relaxed mb-4">
                Une idée, un projet précis ou simplement l'envie de vous lancer ? Commencez petit et évoluez ensuite :
                l'important, c'est de démarrer.
            </p>

            <a href="mailto:bonjour@jphiweb.be" class="text-sm text-primary block mb-8">
                bonjour@jphiweb.be
            </a>

            <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                Parlons de votre projet
            </a>

        </div>
    </section>

{% endblock %}
