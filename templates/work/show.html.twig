{% extends 'base.html.twig' %}

{% block title %}{{ work.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ work.seoDescription }}"/>
{% endblock %}
{% block og_title %}{{ work.seoTitle }}{% endblock %}
{% block og_image %}{{ asset("images/blog/"~work.image) }} {% endblock %}
{% block og_image_alt %}{{ work.seoTitle }}{% endblock %}
{% block og_description %}{{ work.seoDescription }}{% endblock %}
{% block twitter_title %}{{ work.seoTitle }}{% endblock %}
{% block twitter_description %}{{ work.seoDescription }}{% endblock %}
{% block twitter_image %}{{ asset("images/blog/"~work.image) }} {% endblock %}
{% block twitter_image_alt %}{{ work.seoTitle }}{% endblock %}

{% block json_ld %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Service",
            "@id": "{{ absolute_url(path('app_work_show', { slug: work.slug, type: work.type.value })) }}#service",
            "name": "{{ work.name|e('js') }}",
            "description": "{{ work.description|default('Création de site web professionnel.')|striptags|trim|e('js') }}",
            "url": "{{ absolute_url(path('app_work_show', { slug: work.slug , type: work.type.value})) }}",
            {% if work.imageName is defined and work.imageName %}
            "image": "{{ absolute_url(asset('uploads/works/' ~ work.imageName)) }}",
            {% endif %}
            "serviceType": "{{ work.type is defined and work.type ? work.type.value|e('js') : 'Création de site web' }}",
            "provider": {
                "@type": "ProfessionalService",
                "@id": "https://jphiweb.be/#organization",
                "name": "Novitz Jean-Philippe",
                "url": "https://jphiweb.be",
                "telephone": "+32XXXXXXXXy",
                "email": "bonjour@jphiweb.be",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Court-Saint-Étienne",
                    "postalCode": "1490",
                    "addressRegion": "Brabant Wallon",
                    "addressCountry": "BE"
                }
            },
            "areaServed": [
                {
                    "@type": "Place",
                    "name": "Court-Saint-Étienne"
                },
                {
                    "@type": "Place",
                    "name": "Brabant Wallon"
                },
                {
                    "@type": "Country",
                    "name": "Belgique"
                }
            ],
            "offers": {
                "@type": "Offer",
                "url": "{{ absolute_url(path('app_work_show', { slug: work.slug, type: work.type.value })) }}",
                "priceCurrency": "EUR",
                "price": "{{ work.price }}"
            }
        }
    </script>
{% endblock %}

{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}, {label: 'Services', url: path('app_work_index')}],
        current: work.name
    }) }}
{% endblock %}
{% block body %}
{#    <div class="w-full h-full flex flex-col justify-around  md:w-2/3 m-auto">#}
  <section class="bg-base-100">

    <div class="max-w-6xl mx-auto px-6 py-12 lg:py-20">

      <div class="grid grid-cols-1 md:grid-cols-[0.4fr_0.6fr] gap-12 items-center">

        <!-- Image -->

        <figure class="rounded-2xl overflow-hidden aspect-square lg:aspect-[4/5] w-full bg-base-200 border border-base-300 flex items-center justify-center">
          {% if work.image is not null %}
            <img src="/images/work/{{ asset(work.image) }}" alt="{{ work.descriptionShort }}" class="w-full h-full object-cover">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-base-content/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          {% endif %}
        </figure>

 
        <!-- Infos principales -->

        <div class="flex flex-col gap-6">

 

          <!-- Nom -->

          <h1>

            {{work.name}}
          </h1>

 

          <!-- Excerpt -->

          <p class="text-lg text-base-content/70 leading-relaxed">

            {{work.descriptionShort}}
          </p>
          
          {% if work.price %}
            <p class="text-xl">{{work.price}} € HTVA <span class="text-base-content/50">*</span></p>
            <p class="text-xs text-base-content/60 -mt-2">* Hébergement et nom de domaine non compris : entre 50 et 100 € par an, à votre nom, payés directement à l’hébergeur.</p>
          {% endif %}
          <!-- CTA démo -->

          <div class="flex flex-wrap gap-3 pt-2">

            <a

              href="/contact"

              target="_blank"

              class="btn btn-primary gap-2"

            >

              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                 <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5a2.25 2.25 0 00-2.25 2.25m19.5 0l-9.75 6.75L2.25 6.75"/>
              </svg>
              {{ 'contact.me'|trans}}
            </a>
          {% if work.demoUrl %}
            <a

              href="{{work.demoUrl}}"

              target="_blank"

              class="btn btn-outline btn-primary gap-2"

            >

              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">

                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>

                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>

              </svg>

              Voir la démo

            </a>
            {% endif %}


          </div>


        </div>

      </div>

    </div>

  </section>

 

  <!-- Description complète -->

  <section class="bg-base-200">

    <div class="max-w-6xl mx-auto px-6 py-12 lg:py-16">

 

      <div class="divider divider-start text-base font-semibold mb-8">

        {{'about.work'|trans}}
      </div>

 

      <div class="prose prose-lg max-w-4xl text-base-content/80">

        {{work.descriptionLong |raw}}        
      </div>

 

    </div>

  </section>
{% endblock %}
