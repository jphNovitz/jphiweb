{% extends 'base.html.twig' %}

{% block title %}{{ topic.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content="{{ topic.seoSummary }}"/>
{% endblock %}
{% block og_title %}{{ topic.seoTitle }}{% endblock %}
{% block og_image %}{% if topic.image %}{{ asset("images/topic/" ~ topic.image) }}{% else %}{{ asset("images/jphiweb_facebook_image.webp") }}{% endif %}{% endblock %}
{% block og_image_alt %}{{ topic.imageAlt ?: topic.seoTitle }}{% endblock %}
{% block og_description %}{{ topic.seoSummary }}{% endblock %}
{% block twitter_title %}{{ topic.seoTitle }}{% endblock %}
{% block twitter_description %}{{ topic.seoSummary }}{% endblock %}
{% block twitter_image %}{% if topic.image %}{{ asset("images/topic/" ~ topic.image) }}{% else %}{{ asset("images/jphiweb_facebook_image.webp") }}{% endif %}{% endblock %}
{% block twitter_image_alt %}{{ topic.imageAlt ?: topic.seoTitle }}{% endblock %}

{% block json_ld %}
    {% set schema = {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "headline": topic.seoTitle,
        "name": topic.title,
        "description": topic.seoSummary,
        "abstract": topic.summary,
        "keywords": topic.title,
        "about": {
            "@type": "Thing",
            "name": topic.title
        },
        "author": {
            "@type": "Person",
            "@id": "https://jphiweb.be/#person_jphnovitz",
            "name": "Novitz Jean-Philippe"
        },
        "publisher": {
            "@id": "https://jphiweb.be/#organization"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": url('app_topic_show', {slug: topic.slug})
        },
        "articleBody": topic.content|striptags|slice(0, 500)
    } %}

    {% set schema = schema|merge({
        "image": topic.image
            ? absolute_url(asset('images/topic/' ~ topic.image))
            : absolute_url(asset('images/jphiweb_facebook_image.webp'))
    }) %}

    {% if topic.parentTopic %}
        {% set schema = schema|merge({
            "isPartOf": {
                "@type": "CollectionPage",
                "@id": url('app_topic_show', {slug: topic.parentTopic.slug}),
                "name": topic.parentTopic.title
            }
        }) %}
    {% endif %}

    {% set childrenSchema = [] %}
    {% for childTopic in topic.childrenTopics %}
        {% set childrenSchema = childrenSchema|merge([{
            "@type": "CollectionPage",
            "@id": url('app_topic_show', {slug: childTopic.slug}),
            "name": childTopic.title
        }]) %}
    {% endfor %}

    {% set articleSchema = [] %}
    {% for article in topic.articles %}
        {% if article.slug %}
            {% set articleSchema = articleSchema|merge([{
                "@type": "BlogPosting",
                "@id": url('app_blog_show', {topicSlug: article.topic.slug, slug: article.slug}),
                "headline": article.seoTitle,
                "name": article.title
            }]) %}
        {% endif %}
    {% endfor %}

    {% set hasPart = childrenSchema|merge(articleSchema) %}
    {% if hasPart is not empty %}
        {% set schema = schema|merge({
            "hasPart": hasPart
        }) %}
    {% endif %}

    <script type="application/ld+json">
        {{ schema|json_encode(256)|raw }}
    </script>
{% endblock %}

{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}]|merge(topic.parentTopic ? [{label: topic.parentTopic.title, url: path('app_topic_show', {slug: topic.parentTopic.slug})}] : []),
        current: topic.title
    }) }}
{% endblock %}

{% block body %}
    <article class="w-full mx-auto mt-8 p-6 bg-white/10 rounded-lg shadow-lg">
        <div class="max-w-2xl mx-auto">

            <header class="mb-12">
                <h1 class="text-3xl font-bold text-left">
                    {{ topic.title }}
                </h1>

                {% if topic.summary is not empty %}
                    <p class="mt-4">{{ topic.summary }}</p>
                {% endif %}

                <a class="btn btn-primary mt-6" href="{{ path('app_contact') }}">
                    {{ 'get_started' | trans }}
                </a>
            </header>

            <div class="flex flex-col items-start leading-8 text-lg mx-auto my-8">

                {% if topic.image is defined and topic.image is not empty %}
                    <figure class="w-full text-center">
                        <img
                                class="w-full md:w-3/4 h-auto mx-auto my-8 rounded-lg shadow-md"
                                src="{{ asset('images/topic/' ~ topic.image) }}"
                                loading="lazy"
                                {% if topic.imageAlt is not empty %}
                                    alt="{{ topic.imageAlt }}"
                                {% else %}
                                    alt="{{ topic.seoTitle }}"
                                {% endif %}
                        />
                    </figure>
                {% endif %}

                {{ topic.content | raw }}
            </div>

        </div>
    </article>

    <twig:Topic:RelatedPosts topic="{{ topic }}" class="bg-base-200"/>

