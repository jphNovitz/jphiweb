{% extends 'base.html.twig' %}

{% block title %}{{ post.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content="{{ post.seoSummary|trim }}"/>

{% endblock %}
{% block og_title %}{{ post.seoTitle }}{% endblock %}
{% block og_image %}{% if post.image %}{{ absolute_url(asset('images/blog/' ~ post.image)) }}{% else %}{{ absolute_url(asset('images/jphiweb_facebook_image.webp')) }}{% endif %}{% endblock %}
{% block og_image_alt %}{{ post.imageAlt ?: post.seoTitle }}{% endblock %}
{% block og_description %}{{ post.seoSummary }}{% endblock %}
{% block twitter_title %}{{ post.seoTitle }}{% endblock %}
{% block twitter_description %}{{ post.seoSummary }}{% endblock %}
{% block twitter_image %}{% if post.image %}{{ absolute_url(asset('images/blog/' ~ post.image)) }}{% else %}{{ absolute_url(asset('images/jphiweb_facebook_image.webp')) }}{% endif %}{% endblock %}
{% block twitter_image_alt %}{{ post.imageAlt ?: post.seoTitle }}{% endblock %}


{% block json_ld %}
    {% set schema = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": post.seoTitle,
        "description": post.seoSummary,
        "datePublished": post.createdAt|date('c'),
        "dateModified": post.updatedAt|date('c'),
        "author": {
            "@type": "Person",
            "@id": "https://jphiweb.be/#person_jphnovitz",
            "name": "Novitz Jean-Philippe"
        },
        "publisher": {
            "@id": "https://jphiweb.be/#organization"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": url('app_blog_show', {topicSlug: post.topic.slug, slug: post.slug})
        },
        "articleSection": post.topic.title|default(post.topic),
        "abstract": post.summary,
        "articleBody": post.content|striptags|slice(0, 500)
    } %}

    {% set schema = schema|merge({
        "image": post.image
        ? absolute_url(asset('images/blog/' ~ post.image))
        : absolute_url(asset('images/jphiweb_facebook_image.webp'))
    }) %}

    <script type="application/ld+json">
        {{ schema|json_encode(256)|raw }}

    </script>
{% endblock %}


{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}]|merge(post.topic ? [{label: post.topic.title, url: path('app_topic_show', {slug: post.topic.slug})}] : []),
        current: post.title
    }) }}
{% endblock %}

{% block body %}

    {{ component('Blog:Article', {
        'title' : post.title,
        'summary': post.summary,
        'content' : post.content,
        'image_url' : 'blog/'~post.image,
        'image_alt' : post.imageAlt ?: post.title,
        'home' :  app.request.pathinfo == '/'

    }) }}

    <twig:Blog:RelatedPosts post="{{ post }}"/>

{% endblock %}
