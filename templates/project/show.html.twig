{% extends 'base.html.twig' %}

{% block title %}{{ project.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ project.seoSummary }}"/>
{% endblock %}
{% block og_title %}{{ project.seoTitle }}{% endblock %}
{% block og_image %}{{ asset("/images/projets/"~project.image) }} {% endblock %}
{% block og_image_alt %}{{ project.seoTitle }}{% endblock %}
{% block og_description %}{{ project.seoSummary }}{% endblock %}
{% block twitter_title %}{{ project.seoTitle }}{% endblock %}
{% block twitter_description %}{{ project.seoSummary }}{% endblock %}
{% block twitter_image %}{{ asset("/images/projets/"~project.image) }} {% endblock %}
{% block twitter_image_alt %}{{ project.seoTitle }}{% endblock %}


{% block json_ld %}
    {% set schema = {
        "@context": "https://schema.org",
        "@type": "Service",
        "headline": project.seoTitle,
        "description": project.seoSummary,
        "image": absolute_url(asset('images/projets/' ~ project.image)),
        "author": {
            "@type": "Person",
            "@id": "https://jphiweb.be/#person_jphnovitz",
            "name": "Novitz Jean-Philippe"
        },
        "publisher": {
            "@id": "https://jphiweb.be/#organization"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": url('app_project_show', {slug: project.slug})
        },
        "articleSection": project.category.title|default(project.category),
        "abstract": project.seoSummary,
        "articleBody": project.description|striptags|slice(0, 500)
    } %}

    <script type="application/ld+json">
        {{ schema|json_encode(256)|raw }}
    </script>
{% endblock %}


{% block breadcrumb %}
    <nav class="breadcrumbs pt-12 text-xs" aria-label="Fil d'Ariane">
        <ol class="flex-wrap justify-start md:justify-center whitespace-normal">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li><a href="{{ path('app_project_list') }}">Réalisations</a></li>
            <li aria-current="page">{{ project.title }}</li>
        </ol>
    </nav>


{% endblock %}

{% block body %}
    <div class="p-4 md:p-8 lg:p-16 flex flex-col gap-6 md:gap-12 lg:gap-24">
        <!-- Image placeholder -->
        <div class="image-placeholder h-auto flex items-center justify-center mb-6">
            <img src="/images/projets/{{ project.image }}"
                 alt="Image d'illustration du projet {{ project.title }} par pixelservices.be"/>
        </div>
        <div>
            <!-- Titre principal -->
            <twig:Title:H1>{{ project.title }}</twig:Title:H1>

            <!-- Catégories et Technologies -->
            <div class="flex flex-wrap gap-2 mb-4">
                {% if project.category %}
                    <span class="bg-indigo-800 text-indigo-50 font-semibold text-sm px-3 py-1 rounded">{{ project.category.name }}</span>
                {% endif %}
                {% for technology in project.technologies %}
                    <span class="bg-indigo-50 text-indigo-800 border border-indigo-800  text-sm px-3 py-1 rounded">{{ technology.name }}</span>
                {% endfor %}
            </div>

            <!-- Header -->
            {% if project.header %}
                <p class="text-xl font-italic font-semibold mt-6">{{ project.header }}</p>
            {% endif %}
        </div>


        <!-- Corps du texte -->
        <div class="content mb-6 text-lg">
            {{ project.description | raw }}
        </div>

        <!-- Tags, Role et Lien -->
        <div class="additional-info">
            <!-- Tags -->
            <div class="tags flex flex-wrap gap-2 mb-4">
                {% for tag in project.tags %}
                    <span class="bg-amber-500 text-gray-900 font-semibold text-sm px-3 py-1 rounded">{{ tag.name }}</span>
                {% endfor %}
            </div>

            <!-- Rôle -->
            {% if project.role %}
                <div class="role mb-4">
                    <strong>Role:</strong> {{ project.role.name }}
                </div>
            {% endif %}

            <!-- Lien -->
            {% if project.link %}
                <div class="link">
                    <a href="{{ project.link }}" target="_blank"
                       class="text-blue-700 underline">Visitez {{ project.title }}</a>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="w-full my-16 text-sm lg-text-base bg-indigo-50 text-indigo-800 border-t border-b border-indigo-900 p-4 rounded">
        Moi, c’est Jeanphi, développeur et webmaster basé à Court-Saint-Etienne dans le  Brabant wallon, mais disponible pour toute
        la Wallonie. Besoin d’un site qui reflète votre activité ? Parlons-en et donnons vie à vos projets en ligne
        !
    </div>
{% endblock %}
