{% extends 'base.html.twig' %}

{% block title %}{{ project.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ project.seoSummary }}"/>
{% endblock %}
{% block og_title %}{{ project.seoTitle }}{% endblock %}
{% block og_image %}{{ asset("/images/projets/"~project.image) }} {% endblock %}
{% block og_image_alt %}{{ project.seoTitle }}{% endblock %}
{% block og_description %}{{ project.seoSummary }}{% endblock %}
{% block twitter_title %}{{ project.seoTitle }}{% endblock %}
{% block twitter_description %}{{ project.seoSummary }}{% endblock %}
{% block twitter_image %}{{ asset("/images/projets/"~project.image) }} {% endblock %}
{% block twitter_image_alt %}{{ project.seoTitle }}{% endblock %}


{% block json_ld %}
    {% set schema = {
        "@context": "https://schema.org",
        "@type": "Service",
        "headline": project.seoTitle,
        "description": project.seoSummary,
        "image": absolute_url(asset('images/projets/' ~ project.image)),
        "author": {
            "@type": "Person",
            "@id": "https://jphiweb.be/#person_jphnovitz",
            "name": "Novitz Jean-Philippe"
        },
        "publisher": {
            "@id": "https://jphiweb.be/#organization"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": url('app_project_show', {slug: project.slug})
        },
        "articleSection": project.category.title|default(project.category),
        "abstract": project.seoSummary,
        "articleBody": project.description|striptags|slice(0, 500)
    } %}

    <script type="application/ld+json">
        {{ schema|json_encode(256)|raw }}
    </script>
{% endblock %}


{% block breadcrumb %}
    {{ component('Breadcrumb', {
        items: [{label: 'Accueil', url: path('app_home')}, {label: 'Réalisations', url: path('app_project_list')}],
        current: project.title
    }) }}
{% endblock %}

{% block body %}
    <div class="p-4 md:p-8 lg:p-16 flex flex-col gap-6 md:gap-12 lg:gap-24">
        <!-- Image placeholder -->
        <div class="image-placeholder h-auto flex items-center justify-center mb-6">
            <img src="/images/projets/{{ project.image }}"
                 alt="Image d'illustration du projet {{ project.title }} par pixelservices.be"/>
        </div>
        <div>
            <!-- Titre principal -->
            <twig:Title:H1>{{ project.title }}</twig:Title:H1>

            <!-- Catégories et Technologies -->
            <div class="flex flex-wrap gap-2 mb-4">
                {% if project.category %}
                    <span class="badge badge-primary font-semibold">{{ project.category.name }}</span>
                {% endif %}
                {% for technology in project.technologies %}
                    <span class="badge badge-primary badge-outline">{{ technology.name }}</span>
                {% endfor %}
            </div>

            <!-- Header -->
            {% if project.header %}
                <p class="text-xl italic font-semibold mt-6">{{ project.header }}</p>
            {% endif %}
        </div>


        <!-- Corps du texte -->
        <div class="content mb-6 text-lg">
            {{ project.description | raw }}
        </div>

        <!-- Tags, Role et Lien -->
        <div class="additional-info">
            <!-- Tags -->
            <div class="tags flex flex-wrap gap-2 mb-4">
                {% for tag in project.tags %}
                    <span class="badge badge-accent font-semibold">{{ tag.name }}</span>
                {% endfor %}
            </div>

            <!-- Rôle -->
            {% if project.role %}
                <div class="role mb-4">
                    <strong>Rôle :</strong> {{ project.role.name }}
                </div>
            {% endif %}

            <!-- Lien -->
            {% if project.link %}
                <div class="project-link">
                    <a href="{{ project.link }}" target="_blank"
                       class="link link-primary">Visitez {{ project.title }}</a>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="w-full my-16 text-sm lg:text-base bg-base-200 text-base-content border-y border-primary p-4 rounded">
        Un projet similaire en tête ? Je suis Jeanphi, développeur web indépendant à Court-Saint-Étienne.
        J’accompagne les indépendants et PME du Brabant wallon et de toute la Wallonie.
        <a href="{{ path('app_contact') }}" class="link link-primary font-semibold">Parlons de votre projet.</a>
    </div>
{% endblock %}
