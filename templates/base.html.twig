<!DOCTYPE html>
<html lang="fr-BE" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Language" content="fr-BE">
    <link rel="alternate" hreflang="fr-BE" href="https://jphiweb.be{{ app.request.pathInfo }}"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Création de site web Brabant Wallon  | Jphiweb{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}"/>
    <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96"/>
    <link
            rel="preload"
            as="image"
            href="{{ asset('images/home/jphiweb-hero.webp') }}"
            media="(orientation: landscape)"
            fetchpriority="high"
    >
    <link
            rel="preload"
            as="image"
            href="{{ asset('images/home/jphiweb-hero.webp') }}"
            media="(orientation: portrait)"
            fetchpriority="high"
    >
    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}"/>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}"/>
    <link rel="manifest" href="{{ asset('site.webmanifest') }}"/>
    <meta property="fb:app_id" content="211085707686874">
    {% block metas %}
        <meta name="description"
              content="Indépendant ou PME en Brabant Wallon ? Je crée, refonds ou fais évoluer votre site web depuis Court-Saint-Etienne. Prenons contact."/>
    {% endblock %}
    <meta name="author" content="Novitz Jean-Philippe <bonjour@jphiweb.be>"/>
    <meta name="copyright" content="Novitz Jean-Philippe <jphiweb.be>"/>
    {% block follow %}
        <meta name="robots" content="index,follow"/>
    {% endblock %}

    <link rel="canonical" href="{{ absolute_url(app.request.attributes.get('_route')
        ? path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params', {}))
        : path(app.request.pathinfo)) }}"/>

    <meta property="og:title"
          content="{% block og_title %}Votre site web professionnel en Brabant Wallon | Jphiweb{% endblock %}"/>

    <meta property="og:type" content="{% block og_type %}website{% endblock %}"/>
    <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}"/>
    <meta property="og:image"
          content="{% block og_image %}https://jphiweb.be/images/og_image_jphiweb_be.jpg{% endblock %}"/>
    <meta property="og:image:alt" content="{% block og_image_alt %}Site web à Court-Saint-Étienne{% endblock %}">

    <meta property="og:site_name"
          content="{% block og_site_name %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}"/>
    <meta property="og:locale" content="{% block og_locale %}fr_BE{% endblock %}"/>
    <meta property="og:description"
          content="{% block og_description %}Indépendant ou PME en Brabant Wallon ? Création, refonte ou évolution de votre site web depuis Court-Saint-Etienne. Parlons de votre projet.{% endblock %}"/>

    <!-- Image partagée sur les réseaux -->

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title"
          content="{% block twitter_title %}Création de Site Web & SEO dans le Brabant Wallon | Jphiweb{% endblock %}">
    <meta name="twitter:description"
          content="{% block twitter_description %}Expert en création et refonte de sites internet dans le Brabant wallon. Développez votre visibilité locale avec Jphiweb. Devis gratuit.{% endblock %}">
    <meta name="twitter:image"
          content="{% block twitter_image %}https://jphiweb.be/images/og_image_jphiweb_be.jpg {% endblock %}">
    <meta name="twitter:image:alt"
          content="{% block twitter_image_alt %}Création de Site Web à Court-Saint-Etienne dans le Brabant Wallon | Jphiweb{% endblock %}">


    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    {% block json_ld %}
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "ProfessionalService",
                        "@id": "https://jphiweb.be/#organization",
                        "name": "jphiweb.be",
                        "legalName": "Novitz Jean-Philippe",
                        "url": "https://jphiweb.be",
                        "logo": {
                            "@type": "ImageObject",
                            "url": "https://jphiweb.be/images/jphiweb_facebook_image.webp",
                            "width": 1200,
                            "height": 630
                        },
                        "image": "https://jphiweb.be/images/jphiweb_facebook_image.webp",
                        "description": "Partenaire web à Court-Saint-Étienne : création de sites vitrines, e-commerce, optimisation SEO local pour artisans et PME en Brabant Wallon.",
                        "telephone": "+32XXXXXXXXX",
                        "email": "bonjour@jphiweb.be",
                        "priceRange": "€€",
                        "currenciesAccepted": "EUR",
                        "address": {
                            "@type": "PostalAddress",
                            "streetAddress": "",
                            "addressLocality": "Court-Saint-Étienne",
                            "postalCode": "1490",
                            "addressRegion": "Brabant Wallon",
                            "addressCountry": "BE"
                        },
                        "geo": {
                            "@type": "GeoCoordinates",
                            "latitude": 50.6333,
                            "longitude": 4.5667
                        },
                        "areaServed": [
                            {
                                "@type": "City",
                                "name": "Court-Saint-Étienne"
                            },
                            {
                                "@type": "AdministrativeArea",
                                "name": "Brabant Wallon"
                            },
                            {
                                "@type": "Country",
                                "name": "Belgique"
                            }
                        ],
                        "openingHoursSpecification": [
                            {
                                "@type": "OpeningHoursSpecification",
                                "dayOfWeek": [
                                    "Monday",
                                    "Tuesday",
                                    "Wednesday",
                                    "Thursday",
                                    "Friday"
                                ],
                                "opens": "09:00",
                                "closes": "18:00"
                            }
                        ],
                        "sameAs": [
                            "https://www.linkedin.com/in/jphnovitz",
                            "https://www.facebook.com/jphiweb/",
                            "https://www.instagram.com/jphiweb.be"
                        ],
                        "founder": {
                            "@id": "https://jphiweb.be/#person"
                        },
                        "employee": {
                            "@id": "https://jphiweb.be/#person"
                        }
                    },
                    {
                        "@type": "WebSite",
                        "@id": "https://jphiweb.be/#website",
                        "url": "https://jphiweb.be/",
                        "name": "jphiweb.be",
                        "description": "Création de sites web et SEO local pour indépendants et PME en Brabant Wallon",
                        "inLanguage": "fr-BE",
                        "publisher": {
                            "@id": "https://jphiweb.be/#organization"
                        }
                    },
                    {
                        "@type": "Person",
                        "@id": "https://jphiweb.be/#person",
                        "name": "Jean-Philippe Novitz",
                        "jobTitle": "Développeur web freelance",
                        "url": "https://jphiweb.be/",
                        "email": "bonjour@jphiweb.be",
                        "address": {
                            "@type": "PostalAddress",
                            "addressLocality": "Court-Saint-Étienne",
                            "postalCode": "1490",
                            "addressRegion": "Brabant Wallon",
                            "addressCountry": "BE"
                        },
                        "sameAs": [
                            "https://www.linkedin.com/in/jphnovitz",
                            "https://www.facebook.com/jphiweb/",
                            "https://www.instagram.com/jphiweb.be"
                        ],
                        "knowsAbout": [
                            "Création de sites web",
                            "Symfony",
                            "PHP",
                            "SEO local",
                            "Tailwind CSS",
                            "Référencement naturel"
                        ],
                        "worksFor": {
                            "@id": "https://jphiweb.be/#organization"
                        }
                    }
                ]
            }
        </script>
    {% endblock %}

</head>

<body class="bg-base-300 text-pretty">

<div class="max-w-7xl m-auto pt-20 bg-base-200 text-base-content relative">
    {% include '_partials/_navbar.html.twig' %}

    {% for message in app.flashes('success') %}
        <div class="absolute top-16 left-1 right-1 bg-green-600/90  text-white px-8 py-4">
            {{ message|trans }}
        </div>
    {% endfor %}
    {% block breadcrumb %} {% endblock %}
    <main class="p-4 md:p-8 min-h-screen m-auto">
        {% block body %}{% endblock %}
    </main>
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}


    {% endblock %}


</div>
{% include '_partials/_footer.html.twig' %}
</body>
</html>
